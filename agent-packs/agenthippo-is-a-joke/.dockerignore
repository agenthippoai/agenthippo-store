# Generated from Agent Pack agenthippo-is-a-joke@0.1.0 — packs.agenthippo.ai
# Generated by `agenthippo deploy init`. Keeps skills/, references/, scripts/
# (needed at runtime) and drops only VCS/cache/build cruft. node_modules is
# excluded so the Dockerfile reinstalls fresh linux/amd64 deps for skills.
.git
.gitignore
.gitattributes
**/node_modules
**/__pycache__
**/.pytest_cache
**/.mypy_cache
**/.ruff_cache
**/.venv
**/venv
**/*.log
**/dist
**/build
**/.next
**/.turbo
**/.cache
.DS_Store
**/.DS_Store
.idea
.vscode
*.swp
# Secrets anywhere in the pack (defensive; deploy/ secrets are also covered below).
# Keep in sync with isSecretLikeBasename() above.
**/.env
**/*credentials*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks
**/*.gpg
**/*.pgp
**/id_rsa
**/id_dsa
**/id_ecdsa
**/id_ed25519
# deploy/ holds build/deploy artifacts + secrets; only deploy/www/ ships at runtime.
deploy/*
!deploy/www
!deploy/www/**
